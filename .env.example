# Copy to .env for local testing. Never commit the real .env.
# On GitHub Actions these live in Settings > Secrets and variables > Actions.

# Resend API key (dashboard > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain you verified in Resend ("Movie Notifier" is the display name)
EMAIL_FROM=Movie Notifier <alerts@your-domain.in>

# Comma-separated recipients
EMAIL_TO=you@example.com

# What to monitor. MOVIE accepts a movie name (must appear in BookMyShow's
# now-showing/top-upcoming lists), an ET code like ET00518674, or — most
# reliable — the full BookMyShow movie-page URL.
MOVIE=Jailer 2
CITY=bengaluru
# The movie date you care about (YYYY-MM-DD or YYYYMMDD)
MONITOR_DATE=2026-10-19
# Optional: only alert once a venue whose name contains this substring opens.
# Leave empty to be alerted as soon as ANY venue opens.
THEATER=PVR

# Headed browser is the default (BookMyShow's Cloudflare hard-blocks headless
# Chrome with 403). On GitHub Actions the workflow wraps the run in Xvfb.
# Set to true only if you don't need to pass Cloudflare.
HEADLESS=false
